echo "# Python
  __pycache__/
  *.py[cod]
  *$py.class
  .idea/
  .vscode/
  *.sqlite3
  /instance
  .env
  .venv
  env/
  build/
  develop-eggs/
  dist/
  downloads/
  eggs/
  .eggs/
  lib/
  lib64/
  parts/
  sdist/
  var/
  wss/
  .pytest_cache/
  .coverage
  .hypothesis
  .mypy_cache
  .DS_Store
  Thumbs.db" > .gitignore
     Poi fai il primo commit:
  git add .gitignore
  git commit -m "feat: inizializza progetto con .gitignore base"
